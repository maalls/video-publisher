# Copier vers .env. Ne jamais committer ce fichier une fois rempli.
GEMINI_API_KEY=
# Choisir dans AI Studio un modèle ACTUELLEMENT éligible au palier gratuit.
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_APPLICATION_CREDENTIALS=secrets/tts-service-account.json
TTS_VOICE=fr-FR-Wavenet-A
# Facultatif. macOS : après `brew install --cask font-dejavu`, décommente et ajuste si besoin.
# FONT_PATH=~/Library/Fonts/DejaVuSans.ttf
# FONT_BOLD_PATH=~/Library/Fonts/DejaVuSans-Bold.ttf
YOUTUBE_TOKEN_FILE=secrets/youtube-token.json
YOUTUBE_CHANNEL_ID=
# false par défaut. Activation seulement après un essai privé réussi.
ENABLE_YOUTUBE=false
# Optionnel, doit être une piste dont tu détiens les droits pour les deux plateformes.
MUSIC_FILE=
# Facultatif : notifier un service compatible webhook JSON {"text": ...}.
ALERT_WEBHOOK_URL=
# Réservé à l'adaptateur de développement TikTok non relié au cron.
TIKTOK_ACCESS_TOKEN=

FONT_PATH=~/Library/Fonts/DejaVuSans.ttf
FONT_BOLD_PATH=~/Library/Fonts/DejaVuSans-Bold.ttf
